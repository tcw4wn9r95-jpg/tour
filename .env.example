# Required: Claude plans the tours, writes the guide narration and finds restaurants.
ANTHROPIC_API_KEY=

# Optional: override the Claude model / effort (defaults: claude-opus-5 / medium)
# TOUR_CLAUDE_MODEL=claude-opus-5
# TOUR_CLAUDE_EFFORT=medium

# Voice for the audio guide (pick one; without either the app falls back to the
# phone's built-in English voice, still mixed with background music).
# ElevenLabs gives the most natural "podcast host" delivery.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# By default the app stays within ElevenLabs' free 10,000 credits a month (Flash
# voice, a reserve for the main stories, iPhone voice once credits run low).
# Set to false to use your whole plan with the Multilingual v2 voice.
# ELEVENLABS_FREE_TIER=true
OPENAI_API_KEY=
# OPENAI_TTS_VOICE=ash

# Optional: real Google traveler ratings, photos and opening status for restaurant picks.
# Without it, Claude searches the web for top-rated places along your route.
GOOGLE_PLACES_API_KEY=

# Optional but recommended once deployed: a passcode so only you can spend your API credits.
APP_PASSCODE=

# Optional: map tiles. Defaults to OpenStreetMap's standard tiles (no key).
# NEXT_PUBLIC_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
